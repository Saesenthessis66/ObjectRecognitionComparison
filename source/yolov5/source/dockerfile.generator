FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    python3 \
    python3-pip \
    libgl1 \
    libxi6 \
    libxrender1 \
    libxkbcommon0 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install Blender
RUN wget https://download.blender.org/release/Blender3.6/blender-3.6.5-linux-x64.tar.xz \
    && tar -xf blender-3.6.5-linux-x64.tar.xz \
    && mv blender-3.6.5-linux-x64 /blender \
    && rm blender-3.6.5-linux-x64.tar.xz

ENV PATH="/blender:${PATH}"

WORKDIR /app

COPY DataGenerator /app/DataGenerator

WORKDIR /app/DataGenerator

CMD ["blender", "--background", "--python", "main.py"]